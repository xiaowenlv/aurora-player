<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/surface_dark">

    <Button
        android:id="@+id/btn_back"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="@string/back"
        android:contentDescription="返回主界面"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/webdav_connect"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/webdav_host"
        android:textColor="@color/on_surface"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/et_host"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="例如：192.168.1.100"
        android:contentDescription="服务器地址输入框"
        android:inputType="textUri"
        android:textColor="@color/white"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/webdav_port"
        android:textColor="@color/on_surface"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/et_port"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="默认 80"
        android:contentDescription="端口号输入框，默认80"
        android:inputType="number"
        android:textColor="@color/white"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/webdav_username"
        android:textColor="@color/on_surface"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/et_username"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="用户名（可选）"
        android:contentDescription="用户名输入框，可选"
        android:inputType="text"
        android:textColor="@color/white"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/webdav_password"
        android:textColor="@color/on_surface"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/et_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="密码（可选）"
        android:contentDescription="密码输入框，可选"
        android:inputType="textPassword"
        android:textColor="@color/white"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/webdav_path"
        android:textColor="@color/on_surface"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/et_path"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="例如：/music"
        android:contentDescription="路径输入框，例如斜杠music"
        android:inputType="textUri"
        android:textColor="@color/white"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_connect"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/connect"
        android:contentDescription="连接到 WebDAV 服务器"
        android:textSize="18sp"
        android:layout_marginBottom="8dp" />

    <!-- 状态信息：显示每一步的进度和错误详情 -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFCC00"
        android:textSize="13sp"
        android:padding="8dp"
        android:visibility="gone"
        android:layout_marginBottom="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
